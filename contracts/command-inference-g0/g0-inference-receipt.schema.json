{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reis-os://schemas/inference-receipt/1.0.0",
  "title": "InferenceReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "input_hash",
    "output_hash",
    "privacy_decision",
    "model_id",
    "ocs_id",
    "trace_id",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "receipt_id": { "type": "string", "minLength": 8 },
    "input_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "output_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "privacy_decision": {
      "enum": ["ALLOW_LOCAL", "ALLOW_REMOTE", "DENY_REMOTE", "DENY_ALL"]
    },
    "receipt_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "request_id": { "type": "string" },
    "ocs_id": { "type": "string" },
    "model_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "terminal_state": {
      "enum": ["RECEIPTED", "DENIED", "FAILED"]
    }
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<pnml>
  <net id="T2_WFNET_EXTENSION" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>T2_WFNET_EXTENSION</text></name>
    <page id="page0">
      <place id="p_monitor_off"><name><text>monitor_off</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="p_monitor_on"><name><text>monitor_on</text></name></place>
      <place id="p_no_progress"><name><text>no_progress</text></name></place>
      <place id="p_stop"><name><text>stop</text></name></place>

      <transition id="t_monitor_on"><name><text>monitor_on</text></name></transition>
      <transition id="t_detect_noprogress"><name><text>detect_noprogress</text></name></transition>
      <transition id="t_finish_noprogress"><name><text>finish_noprogress</text></name></transition>

      <arc id="a1" source="p_monitor_off" target="t_monitor_on"/>
      <arc id="a2" source="t_monitor_on" target="p_monitor_on"/>
      <arc id="a3" source="p_monitor_on" target="t_detect_noprogress"/>
      <arc id="a4" source="t_detect_noprogress" target="p_no_progress"/>
      <arc id="a5" source="p_no_progress" target="t_finish_noprogress"/>
      <arc id="a6" source="t_finish_noprogress" target="p_stop"/>
    </page>
  </net>
</pnml>

<?xml version="1.0" encoding="UTF-8"?>
<pnml>
  <net id="ANCESTRAL_WFNET_L0" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>ANCESTRAL_WFNET_L0</text></name>
    <page id="page0">
      <place id="p_start"><name><text>start</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="p_observe"><name><text>observe</text></name></place>
      <place id="p_cognize"><name><text>cognize</text></name></place>
      <place id="p_end"><name><text>end</text></name></place>

      <transition id="t_begin"><name><text>begin</text></name></transition>
      <transition id="t_observe_to_cognize"><name><text>observe_to_cognize</text></name></transition>
      <transition id="t_cycle"><name><text>cycle</text></name></transition>
      <transition id="t_finish"><name><text>finish</text></name></transition>

      <arc id="a1" source="p_start" target="t_begin"/>
      <arc id="a2" source="t_begin" target="p_observe"/>
      <arc id="a3" source="p_observe" target="t_observe_to_cognize"/>
      <arc id="a4" source="t_observe_to_cognize" target="p_cognize"/>
      <arc id="a5" source="p_cognize" target="t_cycle"/>
      <arc id="a6" source="t_cycle" target="p_observe"/>
      <arc id="a7" source="p_observe" target="t_finish"/>
      <arc id="a8" source="t_finish" target="p_end"/>
    </page>
  </net>
</pnml>

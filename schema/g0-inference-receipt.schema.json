{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reis-os://schemas/g0-inference-receipt/1.0.0",
  "title": "REIS OS G0 InferenceReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "input_hash",
    "output_hash",
    "privacy_decision",
    "model_id",
    "ocs_id",
    "trace_id",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^ir_[A-Za-z0-9_-]{16,128}$"},
    "input_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "output_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "privacy_decision": {
      "enum": ["ALLOW_LOCAL", "ALLOW_REMOTE", "DENY_REMOTE", "DENY_ALL"]
    },
    "model_id": {"type": "string", "minLength": 1},
    "ocs_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "receipt_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
